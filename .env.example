# Token del bot Telegram (ottenuto da @BotFather)
BOT_TOKEN=inserisci_qui_il_tuo_bot_token

# Opzionale: lista separata da virgole di Chat ID autorizzati (gruppi o privati).
# Lascia vuoto per permettere l'uso ovunque il bot venga aggiunto.
ALLOWED_CHAT_IDS=

# Opzionale: lista separata da virgole di User ID admin (per /ping e notifiche nuovi utenti/gruppi)
ADMIN_IDS=

# Opzionale: invia un messaggio di errore se un link video fallisce (true/false)
NOTIFY_ON_ERROR=true

# Opzionale: scarta i messaggi accumulati mentre il bot era spento (true/false)
DROP_PENDING_UPDATES=false

# Limiti operativi (ottimizzati per VM e2-micro con 445 MiB RAM liberi)
MAX_FILE_SIZE_MB=48
DOWNLOAD_TIMEOUT_MS=60000
MAX_URLS_PER_MESSAGE=3
MAX_QUEUE_SIZE=20
